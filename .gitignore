# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/*

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with -oe
*.out

# Dependency directories (remove the comment below if you prefer to check in vendor directory)
# vendor/

# Go workspace file
go.work
go.work.sum

# Environment variables and secrets
.env
.env.*
!.env.example

# Logs and databases
*.log
*.sqlite
*.sqlite3
*.db
*.dump

# IDEs and editors (VSCode, JetBrains GoLand, Vim)
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary and backup files
*~
*.bak
*.tmp
